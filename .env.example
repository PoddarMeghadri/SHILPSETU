# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Secret for server-side session authentication
JWT_SECRET="shilpsetu_production_jwt_secret_craft_key"

# Clerk Authentication Configuration
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database Configuration (PostgreSQL / Supabase Database URL)
# If not configured, persistent server-side file-backed storage is used
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# For Vercel, add the two VITE_* variables to both Preview and Production.
# The unprefixed SUPABASE_URL/SUPABASE_ANON_KEY names are accepted by the
# Vite build for compatibility with existing deployments.

# Object Storage Configuration (S3 / Cloud Storage / Cloudflare R2)
# When omitted, server saves uploads to persistent local /uploads directory
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


